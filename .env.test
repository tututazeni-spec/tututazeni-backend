DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/innova_test?connection_limit=20&pool_timeout=30"

# PrismaService.DB_POOL_MAX omitido cai no default de 50 ligações por pool —
# cada ficheiro de teste de integração cria a sua própria app Nest (logo o seu
# próprio pool). Com >15 ficheiros a correr sequencialmente no mesmo processo
# jest, isso excede facilmente max_connections=100 do Postgres ("too many
# clients already"), sobretudo durante a transição entre specs. Os testes
# correm sempre em série (--runInBand), por isso um pool pequeno chega.
DB_POOL_MAX=5

JWT_SECRET="test-secret-key-innova-2024-must-be-long"
JWT_REFRESH_SECRET="test-refresh-secret-innova-2024-long"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV="test"

PORT=4001

ALLOWED_FILE_HOST=ci.innova.test
ALLOWED_ORIGINS=http://localhost:4000
APP_URL=http://localhost:4001
METRICS_TOKEN=ci-metrics-token

FRONTEND_URL=http://localhost:3000

AI_PROVIDER=groq
GROQ_API_KEY=fake-key-for-tests
GROQ_MODEL=llama-3.3-70b-versatile

# Leitura por voz das lições (TTS). Deixados VAZIOS de propósito: com valores
# não vazios, getLessonAudio() passa a guarda e faz um fetch real a
# api.elevenlabs.io durante os testes. Vazio → GET /lessons/:id/audio
# devolve 503 sem qualquer chamada de rede (comportamento determinístico).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

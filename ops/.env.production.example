# Template do .env.production do VPS (/opt/innova/.env.production).
# Copiar para .env.production e preencher. NUNCA commitar o ficheiro preenchido.

NODE_ENV=production
PORT=4000
# SHA do commit que gerou esta imagem — injectado automaticamente pelo deploy.sh
# e exposto em GET /health. Permite confirmar a versão exacta a correr no VPS.
BUILD_SHA=unknown

# ─── Base de dados (Postgres gerido/externo — ver docs/db-architecture/) ───
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/innova
DB_POOL_MAX=50
USE_REPLICAS=false
# DATABASE_REPLICA_URL=
# DB_REPLICA_POOL_MAX=10

# ─── Auth ───
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / frontend ───
ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

# ─── URLs e Infraestrutura ───
# URL pública da aplicação (usada em links de PDFs e declarações). Obrigatória.
APP_URL=https://innova.example.com

# URL base do storage externo (Cloudflare R2, S3, etc.).
STORAGE_BASE_URL=https://storage.innova.example.com

# ─── Borda TLS (Caddy — auditoria A-1) ───
# Domínio público que aponta ao VPS (DNS configurado ANTES do primeiro arranque,
# senão o Let's Encrypt falha a emissão e aplica rate-limit).
DOMAIN=innova.example.com
ACME_EMAIL=ops@example.com

# ─── Redis (serviço `redis` do compose) ───
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_ENABLED=true
CACHE_ENABLED=true

# ─── Segurança ───
# Domínios autorizados para fileUrl (separados por vírgula). Obrigatório (auditoria A-5).
# Exemplo: storage.innova.ao,cdn.innova.ao
ALLOWED_FILE_HOST=CHANGE_ME

# Token Bearer para aceder ao Swagger UI em produção (GET /docs). Obrigatório.
SWAGGER_TOKEN=CHANGE_ME

# ─── Observabilidade ───
# Token do guard fail-closed do GET /metrics (regras 6-7). Obrigatório.
# Também alimenta o scrape do Prometheus (deploy.sh gera monitoring/metrics_token).
METRICS_TOKEN=CHANGE_ME

# ─── Alertas (regra 9) — Alertmanager: email + Telegram + dead-man ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=CHANGE_ME
ALERT_EMAIL_TO=ops@example.com
# mesmo bot das notificações de deploy (deploy.yml)
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
# URL de ping do check no healthchecks.io (dead-man externo — ver docs/deploy/alerting.md)
HEALTHCHECKS_PING_URL=https://hc-ping.com/CHANGE_ME

# ─── Backups PostgreSQL → AWS S3 (Faixa B-1 / H-6) ───────────────────────────
# Bucket S3 dedicado a backups (criar separado da app, outra região é melhor).
BACKUP_S3_BUCKET=innova-backups-prod
# Prefixo dentro do bucket (suporta múltiplos ambientes no mesmo bucket).
BACKUP_S3_PREFIX=innova/postgres
# Credenciais IAM com permissões mínimas: s3:PutObject, s3:GetObject, s3:ListBucket, s3:DeleteObject
# (criar utilizador IAM dedicado a backups — NÃO usar as credenciais da app)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-south-1
# Retenção: número de dias a manter backups no S3 (padrão: 30 dias = ~30 dumps)
BACKUP_RETENTION_DAYS=30
# Passphrase GPG para encriptar o dump antes do upload.
# Sem este valor o dump sobe sem encriptação — NÃO recomendado para dados de produção.
# Para gerar: openssl rand -base64 32
BACKUP_ENCRYPT_PASSPHRASE=CHANGE_ME
# Idade máxima do backup (horas) antes de disparar alerta no verify-backup.sh
BACKUP_MAX_AGE_HOURS=26

# ─── WAL-G verify (verify-walg-backup.sh) ────────────────────────────────────
# Endpoint S3-compatible. Vazio = AWS nativo.
# Cloudflare R2: https://ACCOUNT.r2.cloudflarestorage.com
# Backblaze B2 : https://s3.REGION.backblazeb2.com
# MinIO        : http://MINIO_HOST:9000
AWS_ENDPOINT=
# NOTA: as variáveis abaixo pertencem ao ficheiro /etc/walg/walg.env
# (lido por verify-walg-backup.sh). Estão aqui apenas como referência;
# definir neste ficheiro NÃO as tornará visíveis ao script WAL-G.
# Configurar em: ops/backup/walg/walg.env.example → /etc/walg/walg.env
# Número de dias máximo para o último backup WAL-G full antes de alertar
WALG_VERIFY_MAX_AGE_DAYS=8
# Nome do backup a verificar na Fase 3 (checksums). LATEST = mais recente.
WALG_VERIFY_BACKUP_NAME=LATEST

# ─── IA Tutor (opcional — sem estas vars o tutor retorna 503) ───
# Provider activo: groq | gemini | ollama
AI_PROVIDER=groq

GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama3-70b-8192

# GEMINI_API_KEY=CHANGE_ME
# GEMINI_MODEL=gemini-1.5-pro

# ─── Comportamento de Runtime ───
LOG_LEVEL=info
JWT_USER_CACHE_TTL_MS=30000

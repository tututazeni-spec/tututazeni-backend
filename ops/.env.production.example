# Template do .env.production do VPS (/opt/innova/.env.production).
# Copiar para .env.production e preencher. NUNCA commitar o ficheiro preenchido.

NODE_ENV=production
PORT=4000
# SHA do commit que gerou esta imagem — injectado automaticamente pelo deploy.sh
# e exposto em GET /health. Permite confirmar a versão exacta a correr no VPS.
BUILD_SHA=unknown

# ─── Base de dados (Postgres gerido/externo — ver docs/db-architecture/) ───
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/innova
DB_POOL_MAX=50
# PgBouncer (serviço `pgbouncer` do compose): a app liga-se aqui; migrate/exporter usam o directo.
# DATABASE_URL acima é o destino real que o PgBouncer lê. Mesmas credenciais, host `pgbouncer:6432`.
DATABASE_POOLER_URL=postgresql://USER:PASSWORD@pgbouncer:6432/innova
# RLS (ops/db/rls/): com RLS_ENABLED=true a app usa a role innova_app (NOBYPASSRLS), via PgBouncer.
# O PgBouncer precisa de innova_app no userlist/auth. migrate/backups continuam com o owner (DATABASE_URL).
RLS_ENABLED=false
# DATABASE_APP_URL=postgresql://innova_app:PASSWORD@pgbouncer:6432/innova
# DATABASE_REPLICA_APP_URL=
# RLS_PRIVILEGED_ROLES=ADMIN,RH,DIRECTOR,GESTOR,LIDER,AUDITOR,INSTRUCTOR
# Exporter de métricas: utilizador só-leitura (GRANT pg_monitor), ligação DIRECTA ao primary.
DATA_SOURCE_NAME=postgresql://pg_monitor:PASSWORD@HOST:5432/innova?sslmode=require
USE_REPLICAS=false
# DATABASE_REPLICA_URL=
# DB_REPLICA_POOL_MAX=10

# ─── Auth ───
JWT_SECRET=CHANGE_ME
# Cifra de NIF/NIB em repouso (openssl rand -base64 32). Guardar fora do servidor; perdê-la = dados ilegíveis.
PII_ENCRYPTION_KEY=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / frontend ───
ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
# CSRF double-submit: true = token X-CSRF-Token obrigatório em todas as escritas com cookie.
# Deixar false até todas as sessões terem recebido o cookie csrf_token (24h-7d após o deploy).
CSRF_TOKEN_STRICT=false
# IMG_ALLOWED_HOSTS: definido mais abaixo (uma só vez; vazio = qualquer https, inseguro em produção).

# ─── URLs e Infraestrutura ───
# URL pública da aplicação (usada em links de PDFs e declarações). Obrigatória.
APP_URL=https://innova.example.com

# URL base do storage externo (Cloudflare R2, S3, etc.).
STORAGE_BASE_URL=https://storage.innova.example.com

# ─── Borda: Cloudflare (WAF + CDN) → Caddy (TLS origin + load balancer) ───
# Ver docs/deploy/cloudflare.md e docs/deploy/ha-and-spof.md.
#
# A Cloudflare é a borda pública (WAF gerido, CDN, anti-DDoS, rate limiting).
# O ufw só deixa entrar 80/443 dos ranges Cloudflare (deploy/origin-firewall.sh).
# O Caddy termina TLS com um certificado Cloudflare Origin CA (15 anos) em
# /opt/innova/caddy/origin/{cert,key}.pem — SEM emissão ACME. Modo SSL/TLS na
# Cloudflare: "Full (strict)".
#
# Domínio público servido pelo Caddy (tem de bater com o SNI do Origin CA cert
# e com o hostname configurado na Cloudflare).
DOMAIN=innova.example.com
# ACME_EMAIL: já NÃO é usado (auto_https desligado no Caddyfile). Mantido só
# para o ensaio local sem Cloudflare (trocar o `tls` do Caddyfile por `tls internal`).
ACME_EMAIL=ops@example.com

# ─── Redis (serviço `redis` do compose) ───
REDIS_HOST=redis
REDIS_PORT=6379
# Obrigatória: o compose arranca o Redis com --requirepass e a app usa a mesma variável.
# Gerar com: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME
QUEUE_ENABLED=true
CACHE_ENABLED=true

# ─── Segurança ───
# Domínios autorizados para fileUrl (separados por vírgula). Obrigatório (auditoria A-5).
# Exemplo: storage.innova.ao,cdn.innova.ao
ALLOWED_FILE_HOST=CHANGE_ME

# Token Bearer para aceder ao Swagger UI em produção (GET /docs). Obrigatório.
SWAGGER_TOKEN=CHANGE_ME

# ─── Observabilidade ───
# Token do guard fail-closed do GET /metrics (regras 6-7). Obrigatório.
# Também alimenta o scrape do Prometheus (deploy.sh gera monitoring/metrics_token).
METRICS_TOKEN=CHANGE_ME

# ─── Alertas (regra 9) — Alertmanager: email + Telegram + dead-man ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=CHANGE_ME
ALERT_EMAIL_TO=ops@example.com
# E-mail da APLICAÇÃO (convites, reset de password, notificações) — variáveis DIFERENTES das do
# Alertmanager acima (a app lê SMTP_PASS, o Alertmanager lê SMTP_PASSWORD). Podem apontar ao mesmo
# fornecedor, mas as duas têm de estar preenchidas. O domínio do SMTP_FROM tem de ter SPF, DKIM e
# DMARC (docs/deploy/dns-e-email.md; verificar com `npm run ops:dns-check`).
SMTP_PASS=CHANGE_ME
SMTP_FROM="INNOVA <noreply@example.com>"
# mesmo bot das notificações de deploy (deploy.yml)
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
# URL de ping do check no healthchecks.io (dead-man externo — ver docs/deploy/alerting.md)
HEALTHCHECKS_PING_URL=https://hc-ping.com/CHANGE_ME

# ─── Backups PostgreSQL → AWS S3 (Faixa B-1 / H-6) ───────────────────────────
# Bucket S3 dedicado a backups (criar separado da app, outra região é melhor).
BACKUP_S3_BUCKET=innova-backups-prod
# Prefixo dentro do bucket (suporta múltiplos ambientes no mesmo bucket).
BACKUP_S3_PREFIX=innova/postgres
# Credenciais IAM com permissões mínimas: s3:PutObject, s3:GetObject, s3:ListBucket, s3:DeleteObject
# (criar utilizador IAM dedicado a backups — NÃO usar as credenciais da app)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-south-1
# Retenção: número de dias a manter backups no S3 (padrão: 30 dias = ~30 dumps)
BACKUP_RETENTION_DAYS=30
# Passphrase GPG para encriptar o dump antes do upload.
# Sem este valor o dump sobe sem encriptação — NÃO recomendado para dados de produção.
# Para gerar: openssl rand -base64 32
BACKUP_ENCRYPT_PASSPHRASE=CHANGE_ME
# Idade máxima do backup (horas) antes de disparar alerta no verify-backup.sh
BACKUP_MAX_AGE_HOURS=26

# ─── Backup: destino S3-compatible ───────────────────────────────────────────
# Endpoint S3-compatible. Vazio = AWS nativo.
# Cloudflare R2: https://ACCOUNT.r2.cloudflarestorage.com
# Backblaze B2 : https://s3.REGION.backblazeb2.com
# MinIO        : http://MINIO_HOST:9000
AWS_ENDPOINT=

# ─── IA Tutor (opcional — sem estas vars o tutor retorna 503) ───
# Provider activo: groq | gemini | ollama
AI_PROVIDER=groq

GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama3-70b-8192

# GEMINI_API_KEY=CHANGE_ME
# GEMINI_MODEL=gemini-1.5-pro

# ─── Comportamento de Runtime ───
LOG_LEVEL=info
JWT_USER_CACHE_TTL_MS=30000

# ─── Frontend (Next.js) — servido pelo mesmo Caddy em / ──────────────────
# Tag da imagem do frontend no GHCR. O deploy.sh sobrepõe-na a partir do
# repository_dispatch; este valor é o fallback da primeira vez.
FRONTEND_IMAGE_TAG=latest
# URL interna da API para SSR / route handlers do Next (rede Docker do compose).
API_INTERNAL_URL=http://app:4000
# Hostnames https permitidos para imagens externas (img-src da CSP). Vazio =
# qualquer https. Tem de coincidir com a variável de repositório
# IMG_ALLOWED_HOSTS do frontend (build-arg do next/image).
IMG_ALLOWED_HOSTS=storage.innova.example.com

# PEM do CA do Postgres gerido (DigitalOcean: Databases > Connection details > Download CA). Com ele a app valida o certificado;
# sem ele liga cifrado mas sem validar o servidor. Usar 
 no lugar de quebras de linha.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# ─── Observabilidade opcional (Grafana + Loki + Promtail, ~+640 MB de RAM) ───
# Só activar com VPS de 8 GB. UI em 127.0.0.1:3001 (túnel SSH).
ENABLE_OBSERVABILITY=false
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random

# ─── Erros de aplicação (opcional) — vazio = Sentry desligado ───
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

{
  "title": "INNOVA — API",
  "uid": "innova-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Pedidos/s por estado",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status_code) (rate(http_request_duration_seconds_count[5m]))", "legendFormat": "{{status_code}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Latência p95 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }]
    },
    {
      "id": 3, "type": "stat", "title": "Réplicas da app UP",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"innova-app\"})" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Memória / disco do host",
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "RAM usada" },
        { "refId": "B", "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/rootfs\"}", "legendFormat": "disco usado" }
      ]
    },
    {
      "id": 5, "type": "logs", "title": "Erros da app (logs)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service=\"app\"} | json | level=~\"error|fatal\"" }]
    }
  ]
}

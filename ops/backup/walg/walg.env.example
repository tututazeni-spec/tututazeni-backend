# ============================================================
# INNOVA — Variáveis de ambiente do WAL-G
# Copiar para /etc/walg/walg.env e preencher.
# Permissões: chmod 640, chown root:postgres
# NUNCA commitar com valores reais.
# ============================================================

# ── S3 (bucket dedicado a backups WAL — pode ser o mesmo do pg_dump) ──
WALG_S3_PREFIX=s3://innova-backups-prod/walg
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=eu-south-1
# Se usar endpoint compatível com S3 (Cloudflare R2, MinIO, etc.):
# AWS_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# AWS_S3_FORCE_PATH_STYLE=true

# ── PostgreSQL ─────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=innova
PGPASSWORD=CHANGE_ME
# PGDATA é obrigatório para backup-push — normalmente /var/lib/postgresql/16/main
PGDATA=/var/lib/postgresql/16/main

# ── Compressão ──────────────────────────────────────────────────────────
# brotli = melhor rácio (recomendado); lz4 = mais rápido; zstd = equilibrado
WALG_COMPRESSION_METHOD=brotli

# ── Política de retenção incremental ───────────────────────────────────
# Número máximo de backups delta entre fulls (0 = sem delta, só fulls)
# 6 deltas diários + 1 full semanal = 7 dias de RPO horário
WALG_DELTA_MAX_STEPS=6

# ── Concorrência (ajustar conforme CPU/largura de banda disponível) ─────
WALG_UPLOAD_CONCURRENCY=16
WALG_DOWNLOAD_CONCURRENCY=10
WALG_UPLOAD_DISK_CONCURRENCY=2

# ── Retenção no S3 ──────────────────────────────────────────────────────
# Manter os últimos N backups FULL (cada um com os seus deltas associados)
WALG_RETAIN_FULL_BACKUPS=4

# ── Notificação Telegram (reutiliza as variáveis do backup pg_dump) ─────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

NODE_ENV=development

DATABASE_URL="postgresql://USER@localhost:5432/innova_dev"

# ─── Base de dados: pool e read-replicas (ver docs/db-architecture/) ───
# Tamanho máximo do pool de conexões do primary (escrita).
DB_POOL_MAX=50

# Read-replicas (leitura → réplica/slave). Desligadas por omissão: rollback = USE_REPLICAS=false.
USE_REPLICAS=false
DATABASE_REPLICA_URL="postgresql://USER@localhost:5433/innova_dev"
DB_REPLICA_POOL_MAX=10

# ─── Slow query logging (diagnóstico de performance) ───
# Define SLOW_QUERY_LOG para activar o registo de queries lentas.
# SLOW_QUERY_LOG=true
SLOW_QUERY_MS=500
SLOW_QUERY_LOG_FILE=load-tests/reports/slow-queries.log

# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo obrigatório: 32 chars. O boot falha se este valor tiver < 32 chars.
JWT_SECRET=
# Pepper das senhas (HMAC-SHA256 antes do Argon2id). Segredo FORA da BD: um dump da BD sozinho
# não permite ataque offline. Gerar com o comando acima. NUNCA o alterar depois de definido
# (invalida todas as senhas); se o definires só agora, os hashes antigos migram no próximo login.
PASSWORD_PEPPER=
# Custo do Argon2id (opcionais; pisos: 19456 KiB / 2 passagens). Subir não invalida hashes antigos.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Aceitar Authorization: Bearer além do cookie httpOnly (Swagger/clientes legados).
# Pôr a false quando o cookie for o canal único e o Swagger tiver auth própria.
AUTH_ALLOW_BEARER=true

# Sessão inactiva há mais tempo do que isto (ms) é terminada no próximo
# refresh — a cadeia de refresh tokens é revogada e é exigido novo login.
# 1800000 = 30 min.
SESSION_IDLE_TIMEOUT_MS=1800000

FRONTEND_URL=http://localhost:5173

# ─── CORS ───
# Lista separada por vírgulas. Em produção é OBRIGATÓRIA e só aceita https://
# (o bootstrap falha de propósito se faltar — auditoria A-1).
ALLOWED_ORIGINS=http://localhost:3000

# Fila / Redis (item 3a)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
QUEUE_ENABLED=true

# Cache Redis (item 3b)
CACHE_ENABLED=true

# Domínios autorizados para fileUrl (separados por vírgula). Obrigatório: o arranque falha sem ele.
ALLOWED_FILE_HOST=storage.innova.ao

# Validação do conteúdo real dos ficheiros enviados (ver docs/refactor-seguranca-uploads.md §9).
#   enforce (omissão) = recusa executáveis, HTML/SVG, PDF com JavaScript, macros e MIME que não
#                       corresponde aos bytes.
#   warn              = só regista e aceita (usar temporariamente no rollout; cada ocorrência vai
#                       para o AuditLog como UPLOAD_FLAGGED). Tamanho/formato recusam sempre.
UPLOAD_VALIDATION_MODE=enforce
# Uploads por utilizador e por minuto (omissão 20). O frontend só envia um ficheiro de cada vez,
# por isso 20 chega; subir só se houver importações em lote por API.
# UPLOAD_THROTTLE_LIMIT=20

# Antivírus ClamAV (opcional, desligado por omissão). Arranque local: docker compose --profile av up -d
#   Um ficheiro infectado é sempre recusado. CLAMAV_FAIL_MODE decide o que fazer se o clamd estiver
#   em baixo: open (omissão) = o ficheiro passa e a falha fica registada; closed = recusa o upload.
CLAMAV_ENABLED=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=15000
# CLAMAV_FAIL_MODE=open

# ─── URLs e Infraestrutura ────────────────────────────────────────────────────
# URL pública da aplicação (usada em links de documentos, declarações e PDFs)
APP_URL=https://innova.ao

# URL base do storage externo (Cloudflare R2, S3, etc.)
STORAGE_BASE_URL=https://storage.innova.ao

# ─── Segurança e Acesso ───────────────────────────────────────────────────────
# Token Bearer para proteger o endpoint /metrics (Prometheus scraping)
METRICS_TOKEN=change-me-in-production

# Token Bearer para aceder ao Swagger UI em produção (GET /docs)
SWAGGER_TOKEN=change-me-in-production

# ─── IA Tutor ─────────────────────────────────────────────────────────────────
# Provider activo: groq | gemini | ollama
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Avatar de leitura (text-to-speech) ────────────────────────────────────────
# Opcional — sem estas variáveis, GET /lessons/:id/audio devolve 503.
# NUNCA prefixar com NEXT_PUBLIC_: a chave tem de ficar só no backend, que
# expõe GET /lessons/:id/audio como proxy autenticado para o frontend.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Voz da Ísis: eleven_flash_v2_5 (rápido, ~75 ms) ou eleven_multilingual_v2 (mais expressivo, mais lento)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ─── Avatar da Ísis (Simli) ────────────────────────────────────────────────────
# Opcional — sem chave/face a Ísis usa a imagem estática. NUNCA prefixar com
# NEXT_PUBLIC_: o frontend só recebe um token temporário (POST /ai-tutor/avatar/session).
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Limites por sessão (segundos) — o Simli cobra por tempo de uso
# Perfis com acesso ao avatar, separados por vírgula (vazio = todos). Ex.: ADMIN,RH,GESTOR
SIMLI_ALLOWED_ROLES=
SIMLI_MAX_SESSION_SECONDS=600
SIMLI_MAX_IDLE_SECONDS=180

# ─── Configuração de Runtime ──────────────────────────────────────────────────
# Cache TTL do perfil de utilizador no JWT strategy (ms)
JWT_USER_CACHE_TTL_MS=30000

# Nível de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── SMTP (opcional — emails de convite/reset de password + notificações/automação) ──
# Se SMTP_HOST estiver vazio, emails não são enviados (warning nos logs, app continua a funcionar)
# Compatível com qualquer servidor SMTP: Gmail, Brevo, Mailgun, Postfix, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="INNOVA <noreply@innova.ao>"

# ─── Twilio (opcional — SMS/WhatsApp em notificações/automação) ───────────────
# Se TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN estiverem vazios, SMS/WhatsApp não são
# enviados (warning nos logs, app continua a funcionar) — ver src/sms/sms.service.ts
# Conta em https://console.twilio.com — TWILIO_SMS_FROM é o nº Twilio para SMS
# (E.164, ex: +2449XXXXXXX); TWILIO_WHATSAPP_FROM é o nº com WhatsApp activo
# (sandbox de testes ou número aprovado em produção), sem o prefixo "whatsapp:".
# Os destinatários (User.phone) também têm de estar em E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Avatar Training — dias de retenção das transcrições (0 desactiva; por omissão 365)
AVATAR_TRAINING_RETENTION_DAYS=365

# Row Level Security (ops/db/rls/README.md). Só activar depois de correr 01_rls_harden.sql.
# Com RLS_ENABLED=true a app liga-se com a role innova_app (DATABASE_APP_URL) em vez do owner.
RLS_ENABLED=false
# DATABASE_APP_URL=postgresql://innova_app:PASSWORD@localhost:5432/innova_dev
# Roles que passam pelas verificações de RBAC e veem dados de terceiros (COLABORADOR nunca).
# RLS_PRIVILEGED_ROLES=ADMIN,RH,DIRECTOR,GESTOR,LIDER,AUDITOR,INSTRUCTOR
